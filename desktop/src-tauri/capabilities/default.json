{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local Cuts on static-cuts.com may use the folder commands; nothing else gets native access.",
  "windows": ["main"],
  "remote": {
    "urls": ["https://static-cuts.com/*"]
  },
  "permissions": [
    "core:event:default",
    "allow-get-folders",
    "allow-choose-folder",
    "allow-list-watched",
    "allow-read-watched",
    "allow-write-library",
    "allow-get-autostart",
    "allow-set-autostart",
    "allow-tidied",
    "allow-update-status",
    "allow-install-update",
    "allow-ai-status",
    "allow-ai-generate",
    "allow-app-version",
    "allow-check-update"
  ]
}
