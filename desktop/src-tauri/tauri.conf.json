{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Static-Cuts",
  "version": "0.1.0",
  "identifier": "com.static-cuts.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Static-Cuts — Local Cuts",
        "url": "https://static-cuts.com/local?desktop=1",
        "width": 1100,
        "height": 820,
        "minWidth": 420,
        "minHeight": 500,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Static-Cuts",
    "shortDescription": "Local Cuts: tidy your music folder automatically",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
